# Supabase — copy to .env.local and fill in real values.
# Find these in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IDrive e2 (S3-compatible) — blog image storage.
# Console: console.idrivee2.com → API keys. Bucket must exist in the same region.
IDRIVE_E2_ENDPOINT=
IDRIVE_E2_REGION=
IDRIVE_E2_ACCESS_KEY_ID=
IDRIVE_E2_SECRET_ACCESS_KEY=
IDRIVE_E2_BUCKET=
